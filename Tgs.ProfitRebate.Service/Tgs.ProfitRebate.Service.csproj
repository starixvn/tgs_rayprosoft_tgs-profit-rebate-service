<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net7.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UserSecretsId>491e0319-4468-468f-a3a4-5fd2787b9a32</UserSecretsId>
		<DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
		<GlobalNugetConfig>$(UserProfile)\AppData\Roaming\NuGet\NuGet.Config</GlobalNugetConfig>
		<GlobalNugetConfig Condition="'$(UserProfile)'==''">$(HOME)/.nuget/NuGet/NuGet.Config</GlobalNugetConfig>
		<DockerfileBuildArguments>--build-arg "BuildConfiguration=$(Configuration)" --secret id=nuget,src="$(GlobalNugetConfig)"</DockerfileBuildArguments>
		<DockerfileTag Condition="$(DockerfileTag) == ''">tgs-profit-rebate-service</DockerfileTag>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="FluentdForward.OpenTelemetry.MessagePack" Version="0.3.1" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="7.0.7" />
		<PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.18.1" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
		<PackageReference Include="TGS.Core.Infrastructures.Json" Version="0.0.1" />
		<PackageReference Include="Tgs.Logging" Version="0.0.19" />
		<PackageReference Include="Tgs.MessageQueue" Version="2.3.0" />
		<PackageReference Include="Tgs.MessageQueue.MongoDB" Version="2.3.1" />
		<PackageReference Include="Tgs.MessageQueue.Nats" Version="2.3.0" />
		<PackageReference Include="Tgs.MessageQueue.RabbitMQ" Version="2.3.1" />
		<PackageReference Include="OpenTelemetry" Version="1.5.0" />
		<PackageReference Include="OpenTelemetry.Contrib.Instrumentation.EntityFrameworkCore" Version="1.0.0-beta2" />
		<PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.5.0" />
		<PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.5.0" />
		<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.0.0-rc8" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.0.0-rc8" />
		<PackageReference Include="ProfileViewer.OpenTelemetry.Exporter" Version="0.2.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Tgs.ProfitRebate.Core\Tgs.ProfitRebate.Core.csproj" />
	</ItemGroup>

</Project>